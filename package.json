{
  "name": "study-tools-calculator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:legacy": "node --test tests/*.test.js",
    "prepare:mathlive": "node scripts/prepare-mathlive.mjs",
    "predev": "npm run prepare:mathlive",
    "prebuild": "npm run prepare:mathlive",
    "test:e2e": "playwright test",
    "test:e2e:production": "npm run build && playwright test --config=playwright.production.config.ts",
    "postbuild": "node scripts/build-service-worker.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && node scripts/android-gradle.mjs assembleDebug",
    "android:bundle": "npm run android:sync && node scripts/android-gradle.mjs bundleRelease",
    "android:check-release": "node scripts/check-android-release.mjs",
    "android:release": "npm run android:check-release && npm run android:bundle"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.2.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/share": "8.0.3",
    "katex": "^0.16.22",
    "mathjs": "^14.0.1",
    "mathlive": "0.111.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-katex": "3.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "30.1.3",
    "tailwindcss": "^4.1.14",
    "typescript": "7.0.2",
    "vite": "^7.1.9",
    "vitest": "5.0.5"
  }
}
